{
	"$schema": "https://www.schemastore.org/package.json",
	"name": "@acdh-oeaw/viecpro-frontend",
	"private": true,
	"license": "MIT",
	"type": "module",
	"imports": {
		"#/*": "./*"
	},
	"scripts": {
		"analyze": "next analyze",
		"build": "next build",
		"dev": "next dev",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"generate:bibliography": "node ./scripts/generate-bibliography.ts",
		"lint:check": "oxlint",
		"lint:fix": "oxlint --fix",
		"preinstall": "npx only-allow pnpm",
		"prepare": "run-s types:prepare",
		"start": "next start",
		"styles:check": "stylelint \"./**/*.css\" --cache --ignore-path ./.gitignore",
		"styles:fix": "pnpm run styles:check --fix",
		"test": "exit 0",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install --with-deps",
		"test:e2e:update-snapshots": "playwright test --update-snapshots",
		"types:check": "tsc --noEmit",
		"types:prepare": "next typegen"
	},
	"dependencies": {
		"@acdh-oeaw/keystatic-lib": "^0.8.0",
		"@acdh-oeaw/lib": "^0.3.7",
		"@acdh-oeaw/mdx-lib": "^0.2.0",
		"@acdh-oeaw/style-variants": "^0.1.0",
		"@acdh-oeaw/validate-env": "^0.0.3",
		"@keystatic/core": "^0.5.51",
		"@keystatic/next": "^5.0.5",
		"@react-aria/utils": "^3.34.1",
		"@shikijs/rehype": "^3.23.0",
		"@sindresorhus/slugify": "^3.0.1",
		"client-only": "^0.0.1",
		"d3": "^7.9.2",
		"fast-glob": "^3.3.3",
		"image-dimensions": "^2.6.0",
		"json-as-xlsx": "^2.6.5",
		"leaflet": "^1.9.4",
		"lucide-react": "^0.561.0",
		"next": "^16.4.6",
		"next-intl": "^4.15.1",
		"react": "^19.3.1",
		"react-aria": "^3.53.1",
		"react-aria-components": "^1.22.1",
		"react-dom": "^19.3.1",
		"react-leaflet": "^5.0.0",
		"react-schemaorg": "^2.0.1",
		"react-stately": "^3.51.0",
		"rehype-slug": "^6.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx-frontmatter": "^5.2.0",
		"remark-smartypants": "^3.0.3",
		"server-only": "^0.0.1",
		"sharp": "^0.35.5",
		"shiki": "^3.23.0",
		"typesense": "^3.2.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^1.75.1",
		"@playwright/test": "^1.65.0",
		"@react-aria/optimize-locales-plugin": "^2.1.0",
		"@react-types/shared": "^3.37.0",
		"@tailwindcss/turbopack": "^4.3.5",
		"@tailwindcss/typography": "^0.5.20",
		"@types/d3": "^7.4.3",
		"@types/hast": "^3.0.5",
		"@types/leaflet": "^1.9.22",
		"@types/mdx": "^2.0.14",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@x18n/core": "^0.1.14",
		"axe-core": "^4.14.0",
		"axe-playwright": "^2.2.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint-plugin-better-tailwindcss": "^4.11.0",
		"eslint-plugin-check-file": "^3.3.2",
		"eslint-plugin-playwright": "^2.12.2",
		"eslint-plugin-regexp": "^3.3.3",
		"is-in-ci": "^2.0.0",
		"lefthook": "^2.2.2",
		"npm-run-all2": "^8.0.4",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"oxlint-tsgolint": "^7.0.2007",
		"schema-dts": "^1.1.5",
		"stylelint": "^18.0.0",
		"stylelint-order": "^8.1.3",
		"tailwindcss": "^4.3.5",
		"tailwindcss-animate": "^1.0.7",
		"tailwindcss-react-aria-components": "^2.2.0",
		"typescript": "^7.0.2"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"stylelint": {
		"extends": "./config/stylelint/base.json"
	},
	"engines": {
		"node": "^26"
	},
	"packageManager": "pnpm@12.18.0"
}
