{
	"$schema": "https://x18n.dev/schema/config.json",
	"sourceLocale": "de",
	"presets": ["next-intl"],
	"resources": [
		{ "pattern": "messages/{locale}.json" },
		{ "pattern": "content/{locale}/metadata/index.json", "namespace": "metadata" }
	],
	"keyStyle": "nested",
	"write": {
		"sort": "binary",
		"indent": "tab",
		"keepFilled": true
	},
	"review": {
		"enabled": false
	}
}
