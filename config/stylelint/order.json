{
	"$schema": "https://json.schemastore.org/stylelintrc.json",
	"plugins": ["stylelint-order"],
	"rules": {
		"order/order": [
			[
				"custom-properties",
				{ "type": "at-rule", "name": "import" },
				{ "type": "at-rule", "name": "plugin" },
				{ "type": "at-rule", "name": "source" },
				{ "type": "at-rule", "name": "config" },
				{ "type": "at-rule", "name": "custom-variant" },
				{ "type": "at-rule", "name": "theme" },
				{ "type": "at-rule", "name": "apply" },
				"declarations",
				{ "type": "at-rule", "name": "view-transition" },
				"rules",
				"at-rules"
			],
			{ "unspecified": "ignore" }
		],
		"order/properties-order": [
			[
				{
					"groupName": "special",
					"properties": [
						"syntax",
						"inherits",
						"initial-value",
						"system",
						"symbols",
						"additive-symbols",
						"negative",
						"prefix",
						"suffix",
						"range",
						"pad",
						"speak-as",
						"fallback",
						"all",
						"content",
						"quotes",
						"counter-reset",
						"counter-set",
						"counter-increment",
						"writing-mode",
						"direction",
						"text-orientation",
						"unicode-bidi",
						"color-scheme",
						"forced-color-adjust",
						"print-color-adjust",
						"container",
						"container-name",
						"container-type",
						"anchor-name",
						"view-transition-name"
					]
				},
				{
					"groupName": "position",
					"properties": [
						"position",
						"position-anchor",
						"position-area",
						"position-try",
						"position-try-order",
						"position-try-fallbacks",
						"position-visibility",
						"inset",
						"inset-block",
						"inset-block-start",
						"inset-block-end",
						"inset-inline",
						"inset-inline-start",
						"inset-inline-end",
						"top",
						"right",
						"bottom",
						"left",
						"z-index",
						"isolation",
						"float",
						"clear",
						"shape-outside",
						"shape-margin",
						"shape-image-threshold"
					]
				},
				{
					"groupName": "layout",
					"properties": [
						"display",
						"flex-flow",
						"flex-direction",
						"flex-wrap",
						"grid",
						"grid-template",
						"grid-template-areas",
						"grid-template-columns",
						"grid-template-rows",
						"grid-auto-flow",
						"grid-auto-columns",
						"grid-auto-rows",
						"gap",
						"row-gap",
						"column-gap",
						"place-content",
						"align-content",
						"justify-content",
						"place-items",
						"align-items",
						"justify-items",
						"order",
						"flex",
						"flex-grow",
						"flex-shrink",
						"flex-basis",
						"grid-area",
						"grid-column",
						"grid-column-start",
						"grid-column-end",
						"grid-row",
						"grid-row-start",
						"grid-row-end",
						"place-self",
						"align-self",
						"justify-self",
						"columns",
						"column-count",
						"column-width",
						"column-fill",
						"column-span",
						"column-rule"
					]
				},
				{
					"groupName": "box",
					"properties": [
						"box-sizing",
						"aspect-ratio",
						"object-fit",
						"object-position",
						"inline-size",
						"min-inline-size",
						"max-inline-size",
						"width",
						"min-width",
						"max-width",
						"block-size",
						"min-block-size",
						"max-block-size",
						"height",
						"min-height",
						"max-height",
						"margin",
						"margin-block",
						"margin-block-start",
						"margin-block-end",
						"margin-inline",
						"margin-inline-start",
						"margin-inline-end",
						"margin-top",
						"margin-right",
						"margin-bottom",
						"margin-left",
						"padding",
						"padding-block",
						"padding-block-start",
						"padding-block-end",
						"padding-inline",
						"padding-inline-start",
						"padding-inline-end",
						"padding-top",
						"padding-right",
						"padding-bottom",
						"padding-left",
						"contain",
						"content-visibility",
						"contain-intrinsic-size",
						"contain-intrinsic-block-size",
						"contain-intrinsic-inline-size",
						"contain-intrinsic-width",
						"contain-intrinsic-height",
						"overflow",
						"overflow-block",
						"overflow-inline",
						"overflow-x",
						"overflow-y",
						"overflow-clip-margin"
					]
				},
				{
					"groupName": "typography",
					"properties": [
						"font",
						"font-family",
						"src",
						"font-display",
						"unicode-range",
						"size-adjust",
						"ascent-override",
						"descent-override",
						"line-gap-override",
						"font-palette",
						"base-palette",
						"override-colors",
						"font-size",
						"font-size-adjust",
						"line-height",
						"font-weight",
						"font-style",
						"font-stretch",
						"font-variant",
						"font-variant-numeric",
						"font-variation-settings",
						"font-feature-settings",
						"font-optical-sizing",
						"letter-spacing",
						"word-spacing",
						"color",
						"text-align",
						"text-align-last",
						"text-indent",
						"text-transform",
						"text-decoration",
						"text-decoration-line",
						"text-decoration-color",
						"text-decoration-style",
						"text-decoration-thickness",
						"text-underline-offset",
						"text-underline-position",
						"text-emphasis",
						"text-emphasis-style",
						"text-emphasis-color",
						"text-emphasis-position",
						"text-shadow",
						"text-overflow",
						"vertical-align",
						"initial-letter",
						"text-box",
						"text-box-trim",
						"text-box-edge",
						"list-style",
						"list-style-type",
						"list-style-position",
						"list-style-image",
						"text-wrap",
						"text-wrap-mode",
						"text-wrap-style",
						"white-space",
						"white-space-collapse",
						"word-break",
						"line-break",
						"overflow-wrap",
						"hyphens",
						"hyphenate-character",
						"hyphenate-limit-chars",
						"tab-size",
						"font-synthesis",
						"font-kerning",
						"text-rendering",
						"osx-font-smoothing",
						"font-smoothing",
						"text-size-adjust"
					]
				},
				{
					"groupName": "visual",
					"properties": [
						"background",
						"background-color",
						"background-image",
						"background-position",
						"background-size",
						"background-repeat",
						"background-attachment",
						"background-origin",
						"background-clip",
						"background-blend-mode",
						"border",
						"border-width",
						"border-style",
						"border-color",
						"border-block",
						"border-block-start",
						"border-block-end",
						"border-inline",
						"border-inline-start",
						"border-inline-end",
						"border-top",
						"border-right",
						"border-bottom",
						"border-left",
						"border-image",
						"border-image-source",
						"border-image-slice",
						"border-image-width",
						"border-image-outset",
						"border-image-repeat",
						"border-radius",
						"border-start-start-radius",
						"border-start-end-radius",
						"border-end-start-radius",
						"border-end-end-radius",
						"corner-shape",
						"corner-start-start-shape",
						"corner-start-end-shape",
						"corner-end-start-shape",
						"corner-end-end-shape",
						"box-shadow",
						"outline",
						"outline-width",
						"outline-style",
						"outline-color",
						"outline-offset",
						"opacity",
						"visibility",
						"filter",
						"backdrop-filter",
						"mix-blend-mode",
						"mask",
						"mask-image",
						"mask-mode",
						"mask-size",
						"mask-position",
						"mask-repeat",
						"mask-origin",
						"mask-clip",
						"mask-composite",
						"mask-type",
						"clip-path",
						"image-rendering",
						"fill",
						"stroke",
						"stroke-width"
					]
				},
				{
					"groupName": "interaction",
					"properties": [
						"appearance",
						"field-sizing",
						"resize",
						"accent-color",
						"caret",
						"caret-color",
						"caret-shape",
						"cursor",
						"pointer-events",
						"user-select",
						"touch-action",
						"tap-highlight-color",
						"interpolate-size",
						"overscroll-behavior",
						"overscroll-behavior-block",
						"overscroll-behavior-inline",
						"overflow-style",
						"scrollbar-color",
						"scrollbar-gutter",
						"scrollbar-width",
						"scroll-marker-group",
						"scroll-snap-type",
						"scroll-padding",
						"scroll-padding-block",
						"scroll-padding-inline",
						"scroll-snap-align",
						"scroll-snap-stop",
						"scroll-margin",
